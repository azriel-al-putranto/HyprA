{
    "layer": "top",
    "position": "top",
    "height": 38,
    "margin-top": 6,
    "margin-left": 10,
    "margin-right": 10,
    "spacing": 0,
    
    "modules-left": ["custom/launcher", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["group/hardware", "network", "bluetooth", "pulseaudio", "battery", "tray", "custom/power"],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "1": "󰈹", "2": "󰖟", "3": "󰅶", "4": "󰓓", "5": "󰊴",
            "urgent": "󰀧", "active": "⌂", "default": "☀"
        },
        "persistent-workspaces": { "*": 5 }
    },
    "hyprland/window": {
        "format": "{}",
        "max-length": 40,
        "separate-outputs": true
    },
    "clock": {
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰃭 {:%A, %d %B %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "format": { "today": "<span color='#ff9e64'><b>{}</b></span>" }
        }
    },
    "group/hardware": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory", "temperature"],
        "drawer": {
            "transition-duration": 300,
            "children-class": "hardware-child"
        }
    },
    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 2
    },
    "memory": {
        "format": "󰍛 {used:0.1f}G",
        "interval": 2
    },
    "temperature": {
        "thermal-zone": 0,
        "format": "󰔏 {temperatureC}°C",
        "critical-threshold": 80
    },
    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "on-click": "nm-connection-editor",
        "tooltip-format": "{ifname}: {ipaddr}"
    },
    "bluetooth": {
        "format": "󰂯",
        "format-connected": "󰂱",
        "on-click": "blueman-manager",
        "tooltip-format": "{device_alias}"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟",
        "format-icons": ["󰕿", "󰖀", "󰕾"],
        "on-click": "pavucontrol",
        "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+",
        "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "states": { "warning": 30, "critical": 15 }
    },
    "tray": {
        "spacing": 8
    },
    "custom/launcher": {
        "format": "☆",
        "on-click": "fuzzel",
        "tooltip": false
    },
    "custom/power": {
        "format": "󰐥",
        "on-click": "command -v hyprshutdown >/dev/null 2>&1 && hyprshutdown || hyprctl dispatch 'hl.dsp.exit()'",
        "tooltip": false
    }
}
